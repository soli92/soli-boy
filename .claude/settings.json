{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "REPO_ROOT": "${CLAUDE_PROJECT_DIR}"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:registry.npmjs.org)",
      "Bash(npx vite:*)",
      "Bash(npm run dev:*)",
      "Bash(npm --prefix packages/app run dev:*)",
      "Bash(npx playwright:*)",
      "Bash(bash .claude/tools/a11y-scan.sh:*)",
      "Bash(.claude/tools/a11y-scan.sh:*)",
      "Bash(cd packages/app && bash ../../.claude/tools/a11y-scan.sh:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://localhost:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/analytics/show-session-tokens.py\" --from-hook 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/tools/analytics/harvest-session-tokens.py\" --from-hook --project soli-boy 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Analytics: harvest token usage (EP-013 dogfooding)"
          }
        ]
      }
    ]
  }
}
