{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "REPO_ROOT": "${CLAUDE_PROJECT_DIR}"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:registry.npmjs.org)",
      "Bash(npx vite:*)",
      "Bash(npm run dev:*)",
      "Bash(npm --prefix packages/app run dev:*)",
      "Bash(npx playwright:*)",
      "Bash(bash .claude/tools/a11y-scan.sh:*)",
      "Bash(.claude/tools/a11y-scan.sh:*)",
      "Bash(cd packages/app && bash ../../.claude/tools/a11y-scan.sh:*)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://localhost:*)"
    ]
  }
}
