{
  "name": "@soli-boy/app",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Soli-boy — emulatore multipiattaforma (web/desktop/mobile). Codebase condivisa (ADR-001).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --project=chromium",
    "e2e:mobile": "playwright test --project=mobile",
    "e2e:android": "playwright test --project=android ep022-portrait-navbar.e2e.ts ep022-multi-viewport.e2e.ts mobile-touch.e2e.ts",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "cap:build": "npm run build && cap sync",
    "cap:run:android": "cap run android",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
